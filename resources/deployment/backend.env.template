# Copy to backend/.env on the server ONLY. Fill empty credentials before use.
# For an existing database, preserve its APP_KEY; do not generate a different key.
APP_NAME=HRIS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://{{DOMAIN}}
FRONTEND_URL=https://{{DOMAIN}}
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=hris
DB_PASSWORD=
DB_QUEUE_RETRY_AFTER=90

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SESSION_COOKIE=hris_session
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Internal publishing stays private. Browser WSS settings are in frontend.env.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=hris
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8082
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8082
REVERB_ALLOWED_ORIGINS={{DOMAIN}}
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none

# Enable only after configuring and verifying delivery on this server.
HRIS_EMAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_TIMEOUT=15
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_ID=

# Configure a production TURN/STUN provider before external interview UAT.
RECRUITMENT_ICE_SERVERS='[]'

# Use only for a reviewed first-time seed; never copy personal local secrets.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_EMPLOYEE_NUMBER=
ADMIN_FIRST_NAME=
ADMIN_MIDDLE_NAME=
ADMIN_LAST_NAME=
ADMIN_HIRE_DATE=
ADMIN_EMPLOYMENT_TYPE=
COMPANY_NAME=
COMPANY_LEGAL_NAME=
COMPANY_REGISTRATION_NUMBER=
COMPANY_TIN=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_WEBSITE=
COMPANY_ADDRESS_LINE_1=
COMPANY_ADDRESS_LINE_2=
COMPANY_CITY=
COMPANY_PROVINCE=
COMPANY_POSTAL_CODE=
COMPANY_COUNTRY=Philippines
