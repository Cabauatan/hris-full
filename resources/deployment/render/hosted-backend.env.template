# Render Environment only; never commit a filled version or copy the LAN .env.
# APP_URL is the Render HTTPS origin; FRONTEND_URL is the Pages HTTPS origin.
APP_NAME=HRIS
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=
FRONTEND_URL=
# Same independent 64-character lowercase hexadecimal secret as Pages runtime.
# Keeps applicant IP limits separate behind the Pages proxy. Never use VITE_*.
HRIS_PROXY_KEY=
APP_TIMEZONE=Asia/Manila
LOG_CHANNEL=stderr
LOG_LEVEL=warning
PORT=10000

# Separate HRIS schema and account; do not use ticketing's defaultdb.
# Upload this database's public CA certificate as the Render secret file below.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=hris
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/secrets/hris-db-ca.pem
ACK_DEDICATED_DATABASE=false

# Free Render storage is erased on restart/redeploy. This setup is for a demo
# until durable private document storage is configured. No local files migrate.
FILESYSTEM_DISK=local
ACK_EPHEMERAL_STORAGE=false

SESSION_DRIVER=database
SESSION_COOKIE=hris_hosted_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
TRUSTED_PROXIES=

# Enable pending migrations deliberately for the first deployment, then false.
# This flag never runs seeders or resets an existing database.
RUN_MIGRATIONS=false
RUN_REVERB=true
RUN_QUEUE_WORKER=true
RUN_SCHEDULER=true
RUN_TELEGRAM_POLLER=false
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_ALLOWED_ORIGINS=
REVERB_HOST=127.0.0.1
REVERB_PORT=8082
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8082
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none

# Gmail SMTP465 cannot send from Render Free (25/465/587 are blocked).
# Configure a supported delivery provider before enabling outbound email.
HRIS_EMAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=2525
MAIL_TIMEOUT=15
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=HRIS

# One poller per bot. Do not run the same bot on the PC and Render together.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_ID=
RECRUITMENT_ICE_SERVERS='[]'
