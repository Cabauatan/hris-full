# Cloudflare Pages: staged repository root resources/frontend
# Build: npm ci --ignore-scripts && npm run build; output: dist; Node24.
# Set these VITE values BEFORE building the production bundle.
NODE_VERSION=24
VITE_API_BASE_URL=/api/v1
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Also configure these as Pages Function runtime variables in Production.
# HRIS_API_ORIGIN=https://<actual-hris-service>.onrender.com
# HRIS_FRONTEND_ORIGIN=https://<actual-hris-project>.pages.dev
# HRIS_PROXY_KEY=<same 64-character lowercase hex secret as the Render backend>
# Mark HRIS_PROXY_KEY as a Pages runtime secret, not a VITE build variable.
# Never put APP_KEY, database, mail, Telegram or Reverb secrets in VITE_*.
