[Unit]
Description=HRIS database queue worker
After=network-online.target mariadb.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{USER}}
Group={{USER}}
WorkingDirectory={{ROOT}}/backend
ExecStart=/usr/bin/php8.5 artisan queue:work database --queue=notifications,default --sleep=3 --tries=3 --timeout=60 --max-time=3600 --no-interaction
Restart=always
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ROOT}}/backend/storage {{ROOT}}/backend/bootstrap/cache
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
