[Unit]
Description=HRIS scheduled tasks
After=network-online.target mariadb.service

[Service]
Type=oneshot
User={{USER}}
Group={{USER}}
WorkingDirectory={{ROOT}}/backend
ExecStart=/usr/bin/php8.5 artisan schedule:run --no-interaction
TimeoutStartSec=240
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ROOT}}/backend/storage {{ROOT}}/backend/bootstrap/cache
StandardOutput=journal
StandardError=journal
